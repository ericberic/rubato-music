{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PYTHONPATH=$PWD/src uv run python -m aimusic.server.app"
      ],
      "port": 8000
    },
    {
      "name": "webapp",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd webapp && npx vite --port 5173 --strictPort"
      ],
      "port": 5173,
      "url": "http://localhost:5173"
    }
  ]
}